# Edge Caddy for the shared domain. Site address comes from SITE_ADDRESS
# (e.g. my-open-works.net, or "my-open-works.net, www.my-open-works.net");
# a real domain gets an automatic Let's Encrypt certificate.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Applied to everything on the shared domain, so they have to be safe for
	# every prototype: HSTS deliberately omits includeSubDomains (this is a
	# shared apex - don't force HTTPS on unrelated subdomains), and
	# X-Frame-Options is applied only to the app below, so prototypes stay
	# embeddable. Content-Security-Policy is deferred, as it was before the
	# move: the app's inline pre-paint theme script would need a nonce/hash.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
	}

	# Every route is its own `handle` block: handle blocks are mutually
	# exclusive and evaluated in the order written, and bare directives like
	# `redir` would otherwise be ordered after (and never reached because of)
	# the catch-all `handle` at the bottom.

	# The app. The prefix is NOT stripped here - the app's own Caddy
	# (deploy/Caddyfile) expects it, as does the frontend's build-time base.
	@app path /fantasy-adventure-ai /fantasy-adventure-ai/*
	handle @app {
		header X-Frame-Options "DENY"
		reverse_proxy fantasy-web:80
	}

	# TEMPORARY: the app used to live at the domain root, so old bookmarks and
	# links (/saves, /game/<id>, ...) are sent to their new home. Remove once
	# they're no longer in use (the old /api/* URLs can't be redirected).
	@legacy path /saves /saves/* /new-game /new-game/* /game/* /settings /settings/*
	handle @legacy {
		# `*` is required: a first argument starting with / would be parsed as a
		# path matcher, not as the redirect target.
		redir * /fantasy-adventure-ai{uri} 302
	}

	# There is no prototypes index - the landing page is the directory.
	@prototypes_index path /prototypes /prototypes/
	handle @prototypes_index {
		redir * / 302
	}

	# Static prototypes, mounted at /srv/prototypes so the URL path maps
	# straight onto the folder (plain `handle`, not `handle_path`: no prefix
	# stripping, so file_server's own directory redirects stay correct).
	handle /prototypes/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv/landing
		file_server
	}
}
