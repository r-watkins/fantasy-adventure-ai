# Edge Caddy settings (copy to .env next to docker-compose.yml).
#
# Domain Caddy serves and obtains HTTPS certificates for. It must resolve to
# this host (A and, for dual-stack, AAAA records). Comma-separate to serve
# several, e.g. "my-open-works.net, www.my-open-works.net". Defaults to
# localhost for local testing.
SITE_ADDRESS=localhost

# Host folder holding the built static prototypes, one subfolder per id
# (<dir>/<id>/index.html -> /prototypes/<id>/). Production recommendation: a
# folder outside the git checkout (e.g. /opt/prototypes) so `git clean`
# can't remove it. Each prototype must be built to work from
# /prototypes/<id>/ (Vite: base "/prototypes/<id>/" or "./").
PROTOTYPES_DIR=./prototypes

# Host ports. Leave at the defaults in production; override only to run the
# edge locally while 80/443 are already in use.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
