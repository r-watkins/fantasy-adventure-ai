# Production reverse proxy: serves the built frontend, proxies /api/* to the
# backend, and terminates HTTPS automatically (Let's Encrypt) once
# SITE_ADDRESS is set to a real domain that resolves to this host.
#
# Mounted by docker-compose.yml's `web` service (Task 50, `--profile
# production`), which also builds the frontend production image (Task 48)
# that provides the static files served from /srv below. Verified live
# end-to-end during Tasks 48/50: handle-block ordering (/api/* before the
# catch-all), the SPA try_files fallback, and automatic HTTPS all behave as
# intended - real domains get a real Let's Encrypt cert automatically; no
# further config is needed here for that.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Must come before the catch-all `handle` block below: `handle` blocks are
	# mutually exclusive and evaluated in the order they're written, so a
	# request matching /api/* would otherwise also match the catch-all first.
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# SPA fallback: client-side routes (e.g. a deep link refreshed in the
		# browser) must still resolve to index.html, not 404.
		try_files {path} /index.html
		file_server
	}
}
