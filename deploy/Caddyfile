# Application-level reverse proxy for the production `web` container: serves
# the built frontend and proxies the API. It sits BEHIND the shared edge
# Caddy (deploy/edge/), which owns ports 80/443, TLS, the landing page and
# the static prototypes, and forwards /fantasy-adventure-ai* here unchanged.
# So this instance speaks plain HTTP only, on the internal `edge` Docker
# network, and security headers / compression live at the edge.
#
# Everything is served under the /fantasy-adventure-ai prefix. That prefix
# must match, exactly:
#   - the frontend build arg VITE_BASE_PATH=/fantasy-adventure-ai/ (set in
#     docker-compose.yml) - a mismatch shows up as a blank page, because the
#     SPA fallback below answers missing asset URLs with index.html (200);
#   - SESSION_COOKIE_PATH=/fantasy-adventure-ai in .env (backend cookie);
#   - the routes in deploy/edge/Caddyfile.
{
	auto_https off
}

:80 {
	# The bare prefix needs an explicit redirect to the slash form: the
	# handle_path block below only matches /fantasy-adventure-ai/*.
	redir /fantasy-adventure-ai /fantasy-adventure-ai/ 308

	# Must come before the SPA block below: `handle` blocks are mutually
	# exclusive and evaluated in the order they're written. The prefix is
	# stripped so the backend keeps serving plain /api/*.
	handle /fantasy-adventure-ai/api/* {
		uri strip_prefix /fantasy-adventure-ai
		reverse_proxy api:8000
	}

	# handle_path strips the prefix, so the built files stay at the root of
	# /srv exactly as they were when the app was served from the domain root.
	handle_path /fantasy-adventure-ai/* {
		root * /srv
		# SPA fallback: client-side routes (e.g. a deep link refreshed in the
		# browser) must still resolve to index.html, not 404.
		try_files {path} /index.html
		file_server
	}

	# Anything else (the edge only forwards the prefix, so this is just a
	# guard against direct access on the internal network).
	handle {
		respond "Not found" 404
	}
}
