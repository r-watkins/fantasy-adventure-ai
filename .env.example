# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for the full description of each variable once local-dev docs land (Phase 1).

# --- Database ---
# Default inside containers: sqlite+aiosqlite:////data/game.db
# Local non-Docker dev: sqlite+aiosqlite:///./data/game.db
DATABASE_URL=sqlite+aiosqlite:///./data/game.db

# --- Environment ---
# development | production
ENVIRONMENT=development

# --- LLM provider ---
# mock: deterministic, no external calls, no API key required.
# gemini: calls the real Gemini API; requires GEMINI_API_KEY.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
