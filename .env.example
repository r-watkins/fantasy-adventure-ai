# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for the full description of each variable once local-dev docs land (Phase 1).

# --- Database ---
# Default inside containers: sqlite+aiosqlite:////data/game.db
# Local non-Docker dev: sqlite+aiosqlite:///./data/game.db
DATABASE_URL=sqlite+aiosqlite:///./data/game.db

# --- Environment ---
# development | production
ENVIRONMENT=development

# --- LLM provider ---
# mock: deterministic, no external calls, no API key required.
# gemini: calls the real Gemini API; requires GEMINI_API_KEY.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Safety thresholds for the "gemini" provider, starting points for
# "dangerous but not graphic gore" fantasy content. One of BLOCK_NONE |
# BLOCK_ONLY_HIGH | BLOCK_MEDIUM_AND_ABOVE | BLOCK_LOW_AND_ABOVE | OFF.
GEMINI_SAFETY_DANGEROUS_CONTENT=BLOCK_ONLY_HIGH
GEMINI_SAFETY_HARASSMENT=BLOCK_ONLY_HIGH
GEMINI_SAFETY_SEXUALLY_EXPLICIT=BLOCK_MEDIUM_AND_ABOVE

# --- Production reverse proxy (deploy/Caddyfile) ---
# Only used by the production docker-compose "web" service (not local dev).
# Set to a real domain (e.g. adventure.example.com) that resolves to the
# host for Caddy to obtain HTTPS automatically. Defaults to localhost.
SITE_ADDRESS=localhost
